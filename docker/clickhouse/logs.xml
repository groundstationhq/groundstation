<!-- ClickHouse's own logging, kept bounded. By default it logs at trace level
     to text_log and keeps most system log tables forever, so even an idle
     instance grows its data volume every day. -->
<clickhouse>
    <logger>
        <level>warning</level>
    </logger>
    <text_log remove="1"/>
    <trace_log remove="1"/>
    <query_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </part_log>
    <metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <query_views_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </query_views_log>
    <error_log>
        <ttl>event_date + INTERVAL 30 DAY DELETE</ttl>
    </error_log>
</clickhouse>
